{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train model (train.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Run Streamlit app",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "app.py"],
            "console": "integratedTerminal"
        }
    ]
}
